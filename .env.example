# Copy to .env.local for local development, or set these in your hosting dashboard.

# ── Site ─────────────────────────────────────────────────────────────
# Canonical URL, no trailing slash. Used for canonical tags, the sitemap,
# robots.txt, Open Graph images and structured data. Required in production.
NEXT_PUBLIC_SITE_URL=https://www.plumbon24.com

# ── Contact form delivery (configure ONE provider) ──────────────────
# Where service requests are delivered:
CONTACT_TO_EMAIL=plumbon24@gmail.com
# Sender shown on the notification email (must be verified with your provider):
CONTACT_FROM_EMAIL="PLUMBON24 Website <website@plumbon24.com>"

# Option A — Resend (https://resend.com). Photos are attached to the email.
RESEND_API_KEY=

# Option B — SendGrid. Photos are attached to the email.
SENDGRID_API_KEY=

# Option C — Webhook: Formspree, Zapier/Make, a CRM or your own API.
# Receives a JSON POST (photo details only, no files).
CONTACT_WEBHOOK_URL=
# Optional bearer token sent as "Authorization: Bearer <secret>".
CONTACT_WEBHOOK_SECRET=

# ── Optional ─────────────────────────────────────────────────────────
# Google Maps Embed API key. Without it, a keyless Google Maps embed is used.
# This key is visible in the browser by design — restrict it to your domain.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=
